{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aura",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Run the Worker before static assets for the API and MCP, so browser-style
    // navigations don't get the SPA index.html served over real routes.
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*"]
  },
  "observability": { "enabled": true },
  // Nightly refresh of the trailing control days (weather never depends on the phone).
  "triggers": { "crons": ["0 3 * * *"] },
  // Create with: wrangler d1 create aura  (then paste database_id here).
  // Local dev + migrate:local + tests do not need a real id.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aura",
      "database_id": "9f819e8f-9faa-4510-8f46-b152dcd18695",
      "migrations_dir": "migrations"
    }
  ]
  // Secret (set for prod via `wrangler secret put ACCESS_PIN`; put in .dev.vars
  // locally). When unset, the Worker refuses every API request.
}
